<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.bolt.antigravity.PhysicsView
        android:id="@+id/physicsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.bolt.antigravity.MissionControlView
        android:id="@+id/missionControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <com.bolt.antigravity.EditorView
        android:id="@+id/editorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/missionControl"
        app:layout_constraintBottom_toTopOf="@id/terminalView" />

    <com.bolt.antigravity.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
